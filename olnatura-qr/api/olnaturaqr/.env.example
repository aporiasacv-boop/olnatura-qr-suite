# Datasource (obligatorio)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/olnatura_qr
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# JWT (obligatorio; mínimo 32 caracteres en prod)
JWT_SECRET=

# CORS (obligatorio en prod; lista separada por comas)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Dynamics OAuth (obligatorio en prod con APP_DYNAMICS_MODE=real)
APP_DYNAMICS_MODE=mock
APP_DYNAMICS_BASE_URL=
APP_DYNAMICS_RESOURCE=
APP_DYNAMICS_TENANT_ID=
APP_DYNAMICS_CLIENT_ID=
APP_DYNAMICS_CLIENT_SECRET=
